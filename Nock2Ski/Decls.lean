/-- **The parse, pinned**: the bytes parse to `nockDecls`. -/
theorem parse_pin : Front.parseFile nockSrc = some nockDecls := by decide +kernel

/-- The file compiled as skinock compiles it (`generate_forms=False`):
    parsed, then every declaration compiled, without the object-type pass. -/
def nockFile : Option (List (Nm × Term)) :=
  (Front.parseFile nockSrc).bind fun ds => (Front.compileDecls ds).map (·.1)

/-- The same from the parsed declarations. -/
def nockFileD : Option (List (Nm × Term)) := (Front.compileDecls nockDecls).map (·.1)

theorem nockFile_eq : nockFile = nockFileD := by
  unfold nockFile nockFileD; rw [parse_pin]; rfl

/-- A name the file defines. -/
def termD (n : Nm) : Term := (Front.termOf nockFileD n).getD K

theorem pin_of_isSome {o : Option Term} (h : o.isSome = true) : o = some (o.getD K) := by
  cases o with
  | none => cases h
  | some t => rfl

/-- `termD n` is the file's term for `n` when the file has one. -/
theorem termD_pin {n : Nm} (h : (Front.termOf nockFileD n).isSome = true) :
    Front.termOf nockFile n = some (termD n) := by
  rw [nockFile_eq]; exact pin_of_isSome h

end Nock2Ski
